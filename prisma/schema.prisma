generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum TripStatus {
  DRAFT
  OPEN
  WAITLIST
  FULL
  ONGOING
  COMPLETED
  ARCHIVED
}

// What kind of outing a trip is, which decides who can join it (see /faq#joining).
enum TripKind {
  MEETUP
  DAY_TRIP
  STAY_BACK
  INTERNATIONAL
  TREK
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum RegistrationApproval {
  PENDING
  APPROVED
  DECLINED
}

enum CarpoolChoice {
  NONE
  NEED_RIDE
  OFFER_RIDE
}

enum ComeAgain {
  YES
  MAYBE
  NO
}

enum SuggestionKind {
  IDEA
  PLACE
}

enum SuggestionStatus {
  NEW
  PLANNED
  DONE
  NOT_NOW
}

model User {
  staffRole        String?
  whatsappOptIn    Boolean            @default(false)
  whatsappNumber   String?
  deletedAt        DateTime?
  staffTrips       StaffTrip[]
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  image            String?
  role             Role               @default(MEMBER)
  phone            String?
  bloodGroup       String?
  emergencyContact String?
  birthdayMonth    Int?
  birthdayDay      Int?
  registrations    TripRegistration[]
  familyMembers    FamilyMember[]
  feedbacks        Feedback[]
  expensesPaid     Expense[]          @relation("PaidBy")
  paymentEvents    PaymentEvent[]     @relation("RecordedBy")
  tasksOwned       TripTask[]         @relation("TaskOwner")
  incidentsLogged  TripIncident[]     @relation("IncidentReporter")
  feedbackAnswers  FeedbackResponse[]
  createdAt        DateTime           @default(now())
}

model FamilyMember {
  id            String   @id @default(cuid())
  userId        String
  name          String
  relationship  String
  birthdayMonth Int?
  birthdayDay   Int?
  image         String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([birthdayMonth, birthdayDay])
  @@index([userId])
}

model BirthdayDelivery {
  status       String   @default("SENT")
  id           String   @id @default(cuid())
  recipientKey String
  birthdayYear Int
  sentAt       DateTime @default(now())

  @@unique([recipientKey, birthdayYear])
}

model TripMessageDelivery {
  id          String   @id @default(cuid())
  deliveryKey String   @unique
  recipient   String
  kind        String
  status      String   @default("SENDING")
  createdAt   DateTime @default(now())
}

model Trip {
  staffTrips     StaffTrip[]
  id             String             @id @default(cuid())
  title          String
  slug           String?            @unique
  description    String
  startDate      DateTime
  endDate        DateTime
  location       String
  maxCapacity    Int
  status         TripStatus         @default(DRAFT)
  kind           TripKind           @default(DAY_TRIP)
  // Number of attended meetups or one-day trips required before a member can request this trip.
  minimumPriorEvents Int             @default(0)
  // A Drive file id from the gallery folder, shown on trip cards and the trip page.
  coverPhotoId   String?
  budgetEst      Decimal?           @db.Decimal(10, 2)
  adultBudgetEst Decimal?           @db.Decimal(10, 2)
  childBudgetEst Decimal?           @db.Decimal(10, 2)
  itinerary      Json?
  registrations  TripRegistration[]
  expenses       Expense[]
  feedbacks      Feedback[]
  feedbackForm   FeedbackForm?
  responses      FeedbackResponse[]
  suggestions    Suggestion[]
  tasks          TripTask[]
  incidents      TripIncident[]
  paymentEvents  PaymentEvent[]
  createdAt      DateTime           @default(now())
}

model TripRegistration {
  // Existing registrations are retained as approved; new requests enter the organiser approval pipeline.
  approvalStatus      RegistrationApproval @default(APPROVED)
  approvedAt          DateTime?
  promotionVersion     Int            @default(0)
  checkedInCount       Int            @default(0)
  carpoolMatched       Boolean        @default(false)
  id                   String         @id @default(cuid())
  userId               String
  tripId               String
  vehicleDetails       String?
  carpoolChoice        CarpoolChoice  @default(NONE)
  carpoolLocation      String?
  carpoolSeats         Int?
  // Includes the registering adult. Derived from validated companions on the server.
  partySize            Int            @default(1)
  companions           Json           @default("[]")
  familyConsentAt      DateTime?
  parentalConsentAt    DateTime?
  paymentStatus        PaymentStatus  @default(PENDING)
  gearChecked          Boolean        @default(false)
  // When they ticked "18 or over, and I agree to the guidelines". Empty for registrations made before it was asked.
  agreedToGuidelinesAt DateTime?
  paymentEvents        PaymentEvent[]
  user                 User           @relation(fields: [userId], references: [id])
  trip                 Trip           @relation(fields: [tripId], references: [id])
  createdAt            DateTime       @default(now())

  @@unique([userId, tripId])
}

model PaymentEvent {
  requestId      String?          @unique
  id             String           @id @default(cuid())
  tripId         String
  registrationId String
  recordedById   String
  amount         Decimal          @db.Decimal(10, 2)
  method         String
  reference      String?
  note           String?
  createdAt      DateTime         @default(now())
  trip           Trip             @relation(fields: [tripId], references: [id], onDelete: Restrict)
  registration   TripRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  recordedBy     User             @relation("RecordedBy", fields: [recordedById], references: [id])

  @@index([tripId, createdAt])
  @@index([registrationId])
}

model TripTask {
  id          String    @id @default(cuid())
  tripId      String
  title       String
  ownerId     String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  owner       User?     @relation("TaskOwner", fields: [ownerId], references: [id])

  @@index([tripId, completedAt])
}

model TripIncident {
  id           String    @id @default(cuid())
  tripId       String
  reportedById String
  severity     String
  title        String
  description  String
  actionTaken  String?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  trip         Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reportedBy   User      @relation("IncidentReporter", fields: [reportedById], references: [id])

  @@index([tripId, closedAt])
}

model Expense {
  id         String   @id @default(cuid())
  tripId     String
  paidById   String
  title      String
  category   String
  amount     Decimal  @db.Decimal(10, 2)
  receiptUrl String?
  trip       Trip     @relation(fields: [tripId], references: [id])
  paidBy     User     @relation("PaidBy", fields: [paidById], references: [id])
  createdAt  DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  tripId    String?
  rating    Int
  comment   String
  user      User     @relation(fields: [userId], references: [id])
  trip      Trip?    @relation(fields: [tripId], references: [id])
  createdAt DateTime @default(now())
}

/// A trip's feedback form: the standard questions plus the organiser's extras.
model FeedbackForm {
  id        String             @id @default(cuid())
  tripId    String             @unique
  isOpen    Boolean            @default(false)
  intro     String?
  /// Extra questions for this trip: [{ id, type, label, help, options, required }]
  questions Json               @default("[]")
  trip      Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  responses FeedbackResponse[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

/// One person's (or one family's) answers. Anonymous answers keep no name, number or account.
model FeedbackResponse {
  followUpStatus String       @default("NEW")
  followUpNote   String?
  id             String       @id @default(cuid())
  formId         String
  tripId         String
  userId         String?
  anonymous      Boolean      @default(false)
  name           String?
  whatsapp       String?
  groupSize      Int?
  overall        Int
  comeAgain      ComeAgain
  /// The standard aspects: { venue, food, travel, planning, value } -> EXCELLENT | GOOD | NEEDS_WORK | NA
  ratings        Json
  /// Answers to the trip's extra questions, keyed by question id
  extras         Json         @default("{}")
  loved          String?
  leaderIdea     String?
  nextPlace      String?
  shareOk        Boolean      @default(false)
  featured       Boolean      @default(false)
  hidden         Boolean      @default(false)
  verified       Boolean      @default(false)
  flags          String[]     @default([])
  secondsToFill  Int?
  /// Keyed hash of the account or device, so a second submission replaces the first
  dedupeKey      String
  ipHash         String?
  form           FeedbackForm @relation(fields: [formId], references: [id])
  trip           Trip         @relation(fields: [tripId], references: [id])
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  suggestions    Suggestion[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([formId, dedupeKey])
  @@index([tripId, createdAt])
  @@index([ipHash, createdAt])
}

/// An idea or a destination taken from a response, tracked on the suggestions board.
model Suggestion {
  id         String            @id @default(cuid())
  responseId String?
  tripId     String?
  kind       SuggestionKind
  text       String
  topic      String
  status     SuggestionStatus  @default(NEW)
  note       String?
  response   FeedbackResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  trip       Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status, topic])
}

model StaffTrip {
  id     String @id @default(cuid())
  userId String
  tripId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([userId, tripId])
}

model ActivityLog {
  id            String   @id @default(cuid())
  actorId       String?
  entity        String
  entityId      String?
  operation     String
  changedFields String[] @default([])
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model Cancellation {
  id           String   @id @default(cuid())
  tripId       String
  userId       String
  partySize    Int
  wasConfirmed Boolean
  reason       String
  createdAt    DateTime @default(now())

  @@index([tripId, createdAt])
}

model DataRequest {
  id         String    @id @default(cuid())
  userId     String
  kind       String
  status     String    @default("OPEN")
  note       String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, status])
}

model ShopProduct {
  id          String   @id @default(cuid())
  name        String
  description String?
  sizes       String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id             String   @id @default(cuid())
  key            String   @unique
  userId         String
  registrationId String
  tripId         String?
  channel        String
  kind           String
  status         String   @default("QUEUED")
  providerId     String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([providerId])
}
