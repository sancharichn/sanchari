generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum TripStatus {
  DRAFT
  OPEN
  WAITLIST
  FULL
  ONGOING
  COMPLETED
  ARCHIVED
}

// What kind of outing a trip is, which decides who can join it (see /faq#joining).
enum TripKind {
  MEETUP
  DAY_TRIP
  STAY_BACK
  INTERNATIONAL
  TREK
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum ComeAgain {
  YES
  MAYBE
  NO
}

enum SuggestionKind {
  IDEA
  PLACE
}

enum SuggestionStatus {
  NEW
  PLANNED
  DONE
  NOT_NOW
}

model User {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  image            String?
  role             Role               @default(MEMBER)
  phone            String?
  bloodGroup       String?
  emergencyContact String?
  registrations    TripRegistration[]
  feedbacks        Feedback[]
  expensesPaid     Expense[]          @relation("PaidBy")
  feedbackAnswers  FeedbackResponse[]
  createdAt        DateTime           @default(now())
}

model Trip {
  id            String             @id @default(cuid())
  title         String
  description   String
  startDate     DateTime
  endDate       DateTime
  location      String
  maxCapacity   Int
  status        TripStatus         @default(DRAFT)
  kind          TripKind           @default(DAY_TRIP)
  budgetEst     Decimal?           @db.Decimal(10, 2)
  itinerary     Json?
  registrations TripRegistration[]
  expenses      Expense[]
  feedbacks     Feedback[]
  feedbackForm  FeedbackForm?
  responses     FeedbackResponse[]
  suggestions   Suggestion[]
  createdAt     DateTime           @default(now())
}

model TripRegistration {
  id                   String        @id @default(cuid())
  userId               String
  tripId               String
  vehicleDetails       String?
  paymentStatus        PaymentStatus @default(PENDING)
  gearChecked          Boolean       @default(false)
  // When they ticked "18 or over, and I agree to the guidelines". Empty for registrations made before it was asked.
  agreedToGuidelinesAt DateTime?
  user                 User          @relation(fields: [userId], references: [id])
  trip                 Trip          @relation(fields: [tripId], references: [id])
  createdAt            DateTime      @default(now())

  @@unique([userId, tripId])
}

model Expense {
  id         String   @id @default(cuid())
  tripId     String
  paidById   String
  title      String
  category   String
  amount     Decimal  @db.Decimal(10, 2)
  receiptUrl String?
  trip       Trip     @relation(fields: [tripId], references: [id])
  paidBy     User     @relation("PaidBy", fields: [paidById], references: [id])
  createdAt  DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  tripId    String?
  rating    Int
  comment   String
  user      User     @relation(fields: [userId], references: [id])
  trip      Trip?    @relation(fields: [tripId], references: [id])
  createdAt DateTime @default(now())
}

/// A trip's feedback form: the standard questions plus the organiser's extras.
model FeedbackForm {
  id        String             @id @default(cuid())
  tripId    String             @unique
  isOpen    Boolean            @default(false)
  intro     String?
  /// Extra questions for this trip: [{ id, type, label, help, options, required }]
  questions Json               @default("[]")
  trip      Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  responses FeedbackResponse[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

/// One person's (or one family's) answers. Anonymous answers keep no name, number or account.
model FeedbackResponse {
  id            String       @id @default(cuid())
  formId        String
  tripId        String
  userId        String?
  anonymous     Boolean      @default(false)
  name          String?
  whatsapp      String?
  groupSize     Int?
  overall       Int
  comeAgain     ComeAgain
  /// The standard aspects: { venue, food, travel, planning, value } -> EXCELLENT | GOOD | NEEDS_WORK | NA
  ratings       Json
  /// Answers to the trip's extra questions, keyed by question id
  extras        Json         @default("{}")
  loved         String?
  leaderIdea    String?
  nextPlace     String?
  shareOk       Boolean      @default(false)
  featured      Boolean      @default(false)
  hidden        Boolean      @default(false)
  verified      Boolean      @default(false)
  flags         String[]     @default([])
  secondsToFill Int?
  /// Keyed hash of the account or device, so a second submission replaces the first
  dedupeKey     String
  ipHash        String?
  form          FeedbackForm @relation(fields: [formId], references: [id])
  trip          Trip         @relation(fields: [tripId], references: [id])
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  suggestions   Suggestion[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([formId, dedupeKey])
  @@index([tripId, createdAt])
  @@index([ipHash, createdAt])
}

/// An idea or a destination taken from a response, tracked on the suggestions board.
model Suggestion {
  id         String            @id @default(cuid())
  responseId String?
  tripId     String?
  kind       SuggestionKind
  text       String
  topic      String
  status     SuggestionStatus  @default(NEW)
  note       String?
  response   FeedbackResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  trip       Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status, topic])
}
