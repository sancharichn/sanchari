# Copy to .env for local development. Never commit .env.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# Neon Postgres (console.neon.tech → project sanchariwebsite → branch production → Connect)
# connect_timeout=15 gives Neon time to wake a suspended compute instead of failing the first request.
# Pooled connection string (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Direct connection string (no "-pooler") — used by prisma db push
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth client (Google Cloud → Google Auth Platform → Clients → Web application)
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Signs in as ADMIN; everyone else is MEMBER
ADMIN_EMAIL="sanchari.chn@gmail.com"
# Birthday email delivery through the Google account sanchari.chn
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
BIRTHDAY_FROM_EMAIL="sanchari.chn@gmail.com"
CRON_SECRET=""

# Instagram feed (Instagram API with Instagram Login, long-lived token, refresh every ~60 days)
INSTAGRAM_HANDLE="sanchari.chennai"
INSTAGRAM_ACCESS_TOKEN=""

# Gallery: Drive folder shared (Viewer) with the service account's email
GOOGLE_DRIVE_FOLDER_ID=""
# The service account key JSON, pasted as-is (or base64-encoded)
GOOGLE_SERVICE_ACCOUNT_JSON=""
